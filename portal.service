[Unit]
Description=Portal de Gestao de Projetos Streamlit
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/portal_projetos
ExecStart=/opt/portal_projetos/venv/bin/streamlit run app.py --server.port=8501 --server.address=0.0.0.0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
